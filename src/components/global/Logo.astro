---
interface Props {
  label: string;
}
const { label } = Astro.props;
---

<a class="logo" href="/" aria-label={label}>
  <span class="logo-mark" aria-hidden="true">
    <svg viewBox="0 0 24 24" fill="none"><path d="M5 5 12 18 19 5" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>
  </span>
  <span class="logo-text">Virat Digital</span>
</a>
