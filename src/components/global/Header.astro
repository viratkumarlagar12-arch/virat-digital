---
import { getCollection } from 'astro:content';
import Icon from '../ui/Icon.astro';
import Logo from './Logo.astro';
import { nav, whatsappUrl, isCurrent } from '../../data/site';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const path = Astro.url.pathname;
const current = (href: string) => (isCurrent(href, path) ? 'page' : undefined);
---

<header class="site-header" id="siteHeader">
  <div class="container header-inner">
    <Logo label="Virat Digital home" />

    <div class="header-actions">
      <button class="icon-btn theme-toggle" id="themeToggle" type="button" aria-label="Switch to light theme">
        <Icon name="sun" class="icon-sun" />
        <Icon name="moon" class="icon-moon" />
      </button>
      <!-- Without JavaScript the menu can't open, so this jumps to the footer's full navigation instead. -->
      <a class="btn btn-outline btn-sm nav-fallback" href="#footer-nav">Menu</a>
      <button class="icon-btn nav-toggle" id="navToggle" type="button" aria-expanded="false" aria-controls="primaryNav" aria-label="Open menu">
        <span></span><span></span><span></span>
      </button>
    </div>

    <nav class="nav" id="primaryNav" aria-label="Primary">
      <ul class="nav-list">
        <li class="nav-group" id="servicesGroup">
          <button class="nav-link nav-disclosure" type="button" aria-expanded="false" aria-controls="servicesMenu">
            Services <Icon name="chevron" />
          </button>
          <span class="nav-group-label" id="servicesLabel">Services</span>
          <ul class="nav-menu" id="servicesMenu" aria-labelledby="servicesLabel">
            {services.map((s) => (
              <li>
                <a href={`/services/${s.id}/`} aria-current={current(`/services/${s.id}/`)}>
                  {s.data.title}
                  <span class="nav-menu-desc">{s.data.menuLine}</span>
                </a>
              </li>
            ))}
            <li class="nav-menu-all"><a href="/services/" aria-current={path === '/services/' ? 'page' : undefined}>All services</a></li>
          </ul>
        </li>
        {nav.map((item) => (
          <li><a class="nav-link" href={item.href} aria-current={current(item.href)}>{item.label}</a></li>
        ))}
      </ul>
      <div class="nav-actions">
        <a class="btn btn-primary nav-cta" href="/contact/">Start a project</a>
        <a class="btn btn-outline nav-wa" href={whatsappUrl("Hi Virat Digital, I'd like to talk about a project.")} target="_blank" rel="noopener noreferrer">
          <Icon name="whatsapp" /> Message on WhatsApp
        </a>
      </div>
    </nav>
  </div>
</header>

<script>
  const root = document.documentElement;
  const header = document.getElementById('siteHeader');

  /* ---- Theme: follows the device until the visitor picks; the choice is remembered ---- */
  const THEME_KEY = 'vd-theme'; // same key as the inline script in BaseLayout
  const THEME_COLORS = { dark: '#0b0b0f', light: '#f5f5f9' }; // --onyx-950, --ink-50
  const themeToggle = document.getElementById('themeToggle');
  const lightQuery = window.matchMedia('(prefers-color-scheme: light)');

  function savedTheme() {
    try { return localStorage.getItem(THEME_KEY); } catch { return null; }
  }

  function applyTheme(theme: 'light' | 'dark') {
    // Switch without transitions so text and backgrounds change together.
    root.classList.add('theme-switching');
    root.setAttribute('data-theme', theme);
    void root.offsetWidth;
    requestAnimationFrame(() => root.classList.remove('theme-switching'));
    document.querySelectorAll('meta[name="theme-color"]').forEach((meta) => meta.setAttribute('content', THEME_COLORS[theme]));
    themeToggle?.setAttribute('aria-label', theme === 'light' ? 'Switch to dark theme' : 'Switch to light theme');
  }

  applyTheme(root.getAttribute('data-theme') === 'light' ? 'light' : 'dark');

  themeToggle?.addEventListener('click', () => {
    const next = root.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
    try { localStorage.setItem(THEME_KEY, next); } catch { /* private mode: still switch */ }
    applyTheme(next);
  });

  lightQuery.addEventListener('change', (e) => {
    if (!savedTheme()) applyTheme(e.matches ? 'light' : 'dark');
  });

  /* ---- Header turns solid once the page scrolls ---- */
  const updateHeader = () => header?.classList.toggle('is-scrolled', window.scrollY > 8);
  window.addEventListener('scroll', updateHeader, { passive: true });
  updateHeader();

  /* ---- Services menu (desktop disclosure) ---- */
  const group = document.getElementById('servicesGroup');
  const disclosure = group?.querySelector<HTMLButtonElement>('.nav-disclosure');

  function setDisclosure(open: boolean, returnFocus = false) {
    if (!disclosure) return;
    disclosure.setAttribute('aria-expanded', String(open));
    if (!open && returnFocus) disclosure.focus();
  }
  const disclosureOpen = () => disclosure?.getAttribute('aria-expanded') === 'true';

  disclosure?.addEventListener('click', () => setDisclosure(!disclosureOpen()));
  document.addEventListener('click', (e) => {
    if (disclosureOpen() && group && !group.contains(e.target as Node)) setDisclosure(false);
  });
  group?.addEventListener('focusout', (e) => {
    if (disclosureOpen() && !group.contains(e.relatedTarget as Node | null)) setDisclosure(false);
  });

  /* ---- Mobile menu ---- */
  const navToggle = document.getElementById('navToggle');
  const nav = document.getElementById('primaryNav');
  const behind = () => document.querySelectorAll<HTMLElement>('main, .site-footer, .wa-sticky');
  const menuOpen = () => nav?.classList.contains('is-open') ?? false;

  function setMenu(open: boolean, returnFocus = false) {
    if (!nav || !navToggle) return;
    const wasOpen = menuOpen();
    nav.classList.toggle('is-open', open);
    header?.classList.toggle('menu-open', open);
    root.classList.toggle('menu-open', open);
    navToggle.setAttribute('aria-expanded', String(open));
    navToggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    behind().forEach((el) => { el.inert = open; });
    if (!open && wasOpen && returnFocus) navToggle.focus();
  }

  navToggle?.addEventListener('click', () => setMenu(!menuOpen()));
  nav?.addEventListener('click', (e) => {
    if ((e.target as Element).closest('a')) setMenu(false);
  });

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    if (disclosureOpen()) setDisclosure(false, true);
    else if (menuOpen()) setMenu(false, true);
  });

  // Reset the mobile menu if the viewport grows to desktop.
  window.matchMedia('(min-width: 64em)').addEventListener('change', (e) => {
    if (e.matches) setMenu(false);
  });
</script>
