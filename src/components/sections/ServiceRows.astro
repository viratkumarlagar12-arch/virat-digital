---
import { getServices } from '../../lib/content';

interface Props {
  headingLevel?: 2 | 3;
}
const { headingLevel = 3 } = Astro.props;
const Heading = headingLevel === 2 ? 'h2' : 'h3';
const services = await getServices();
---

<ul class="service-rows">
  {services.map((s) => (
    <li class="service-row">
      <Heading class="service-row-title"><a class="card-link" href={`/services/${s.id}/`}>{s.data.title}</a></Heading>
      <div class="service-row-copy">
        <p class="service-row-outcome">{s.data.outcome}</p>
        <p class="t-small">{s.data.audience}</p>
      </div>
      <ul class="service-row-includes" aria-label={`${s.data.title} includes`}>
        {s.data.includes.map((item) => <li>{item}</li>)}
      </ul>
    </li>
  ))}
</ul>

<style>
  @layer sections {
    .service-rows { border-top: 1px solid var(--line-strong); }
    .service-row {
      position: relative;
      display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-4) var(--grid-gap);
      padding-block: var(--space-8);
      border-bottom: 1px solid var(--line-strong);
    }
    .service-row:has(.card-link:focus-visible) { outline: 2px solid var(--focus-ring); outline-offset: 4px; }
    .service-row-title {
      font-size: var(--text-xl); font-weight: var(--weight-bold); font-stretch: var(--heading-wdth);
      letter-spacing: var(--tracking-heading); line-height: 1.1;
    }
    /* Below the section's h2 on phones; the larger size from tablets up */
    @media (min-width: 48em) { .service-row-title { font-size: var(--text-2xl); } }
    .service-row-title a { color: var(--text); text-decoration-color: transparent; text-underline-offset: .2em; }
    .service-row:hover .service-row-title a { text-decoration-color: var(--link-underline); }
    /* Touch screens can't hover, so the titles show they're links up front. */
    @media (hover: none) { .service-row-title a { text-decoration-color: var(--link-underline); } }
    .service-row-outcome { color: var(--text); font-size: var(--text-md); line-height: 1.5; }
    .service-row-copy .t-small { margin-top: var(--space-2); color: var(--text-subtle); }
    /* Two to a row below desktop, one column on desktop: always a list, never run-on text. */
    .service-row-includes { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-1) var(--space-4); font-size: var(--text-sm); }
    @media (min-width: 64em) {
      .service-row { grid-template-columns: minmax(0, 4fr) minmax(0, 5fr) minmax(0, 3fr); align-items: start; }
      .service-row-includes { grid-template-columns: minmax(0, 1fr); gap: var(--space-1); }
    }
  }
</style>
