---
import { site } from '../../data/site';

const youtube = site.socials.find((s) => s.name === 'YouTube')!;
---

<section class="section section-alt">
  <div class="container split">
    <div class="section-head">
      <h2>Who you’ll work with</h2>
    </div>
    <div class="about-teaser">
      <p class="about-statement">
        Virat Digital is a one-person studio. The person you message is the person doing the work.
      </p>
      <p>
        Design, websites, automation and marketing work best planned together, not bought as four separate jobs.
      </p>
      <div class="cluster">
        <a class="link-action" href="/about/">More about how I work</a>
        <a class="link-action" href={youtube.url} target="_blank" rel="noopener noreferrer">Watch {youtube.handle} on YouTube</a>
      </div>
    </div>
  </div>
</section>

<style>
  @layer sections {
    .about-teaser { display: grid; gap: var(--space-5); }
    .about-teaser > p { max-width: var(--measure); }
    .about-teaser > .about-statement {
      color: var(--text);
      font-size: var(--text-xl); font-weight: var(--weight-medium);
      line-height: 1.4; letter-spacing: var(--tracking-title);
      max-width: 32ch;
    }
    .about-teaser .cluster { --cluster-gap: var(--space-3) var(--space-8); margin-top: var(--space-2); }
  }
</style>
