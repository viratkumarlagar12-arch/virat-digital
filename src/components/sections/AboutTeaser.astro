---
import { Picture } from 'astro:assets';
import { site } from '../../data/site';
import portrait from '../../assets/about/virat-kumar-portrait.png';

const youtube = site.socials.find((s) => s.name === 'YouTube')!;
const portraitAlt = site.founderName ? `${site.founderName}, founder of Virat Digital` : 'Portrait of the founder of Virat Digital';
---

<section class="section section-alt">
  <div class="container split">
    <div class="section-head">
      <h2>Who you’ll work with</h2>
      <!-- A real photo, cropped only. Under the heading on laptops; between
           the heading and the statement when the section stacks. -->
      <figure class="about-portrait media media-framed">
        <Picture
          src={portrait}
          alt={portraitAlt}
          formats={['avif', 'webp']}
          widths={[160, 240, 320, 480, 640]}
          sizes="(min-width: 64em) 15rem, 10rem"
          loading="lazy"
        />
      </figure>
    </div>
    <div class="about-teaser">
      <p class="about-statement">
        Virat Digital is a one-person studio. The person you message is the person doing the work.
      </p>
      <p>
        Design, websites, automation and marketing work best planned together, not bought as four separate jobs.
      </p>
      <div class="cluster">
        <a class="link-action" href="/about/">More about how I work</a>
        <a class="link-action" href={youtube.url} target="_blank" rel="noopener noreferrer">Watch {youtube.handle} on YouTube</a>
      </div>
    </div>
  </div>
</section>

<style>
  @layer sections {
    .about-teaser { display: grid; gap: var(--space-5); }
    .about-teaser > p { max-width: var(--measure); }
    .about-teaser > .about-statement {
      color: var(--text);
      font-size: var(--text-xl); font-weight: var(--weight-medium);
      line-height: 1.4; letter-spacing: var(--tracking-title);
      max-width: 32ch;
    }
    .about-teaser .cluster { --cluster-gap: var(--space-3) var(--space-8); margin-top: var(--space-2); }

    .about-portrait { --media-ratio: 4 / 5; width: 10rem; margin: var(--space-2) 0 0; }
    .about-portrait :global(img) { display: block; }
    @media (min-width: 64em) { .about-portrait { width: 15rem; margin-top: var(--space-6); } }
  }
</style>
