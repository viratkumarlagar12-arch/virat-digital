---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sections/Hero.astro';
import WorkGrid from '../components/sections/WorkGrid.astro';
import ServiceRows from '../components/sections/ServiceRows.astro';
import ProcessSteps from '../components/sections/ProcessSteps.astro';
import Commitments from '../components/sections/Commitments.astro';
import AboutTeaser from '../components/sections/AboutTeaser.astro';
import Faq from '../components/sections/Faq.astro';
import ContactBlock from '../components/sections/ContactBlock.astro';
import { site } from '../data/site';
import { faq } from '../data/faq';
import { getProjects } from '../lib/content';

const featured = (await getProjects()).filter((p) => p.data.featured).slice(0, 3);
---

<BaseLayout title="Virat Digital | Design, websites and automation for creators" description={site.description}>
  <Hero />

  <section class="section section-alt">
    <div class="container">
      <div class="section-head section-head-split">
        <h2>Selected work</h2>
        <p>Self-initiated and concept projects, each labelled for what it is. Client work joins as it ships.</p>
      </div>
      <WorkGrid projects={featured} />
      <p class="see-all"><a class="link-action" href="/work/">See all work</a></p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head section-head-split">
        <h2>Services</h2>
        <p>Five ways I can help. Each one has its own page with what’s included and how it works.</p>
      </div>
      <ServiceRows />
    </div>
  </section>

  <ProcessSteps class="section-alt" />
  <Commitments />
  <AboutTeaser />
  <Faq items={faq} />
  <ContactBlock title="Tell me about your project" />
</BaseLayout>

<style>
  @layer sections {
    .see-all { margin-top: var(--space-10); }
  }
</style>
