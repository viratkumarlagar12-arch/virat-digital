---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/sections/PageHero.astro';
import ServiceRows from '../../components/sections/ServiceRows.astro';
import ProcessSteps from '../../components/sections/ProcessSteps.astro';
import ContactBlock from '../../components/sections/ContactBlock.astro';
---

<BaseLayout
  crumbs={[{ name: 'Services', path: '/services/' }]}
  title="Services | Virat Digital"
  description="Graphic design, YouTube design, websites, AI automation and digital marketing for creators and small businesses, with a fixed quote up front."
>
  <PageHero
    title="Services"
    lead="Five services for creators and small businesses. Each works alone, and better together."
  />

  <section class="section-sm">
    <div class="container">
      <ServiceRows headingLevel={2} />
    </div>
  </section>

  <ProcessSteps class="section-alt" />
  <ContactBlock title="Not sure which you need?" lead="Describe the goal. I’ll suggest a starting point, or say if I’m not the right fit." />
</BaseLayout>
