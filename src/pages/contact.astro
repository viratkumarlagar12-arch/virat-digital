---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/sections/PageHero.astro';
import ContactBlock from '../components/sections/ContactBlock.astro';
import { commitments } from '../data/site';
---

<BaseLayout
  crumbs={[{ name: 'Start a project', path: '/contact/' }]}
  title="Start a project | Virat Digital"
  description="Start a project with Virat Digital. Send a short message or a WhatsApp, and get a personal reply with next steps and a fixed quote."
>
  <PageHero
    title="Start a project"
    lead={`A personal reply within ${commitments.replyHours} hours, and a fixed quote before anything starts.`}
  />
  <ContactBlock flush />
</BaseLayout>
